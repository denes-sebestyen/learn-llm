{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "learn-llm",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-02",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
