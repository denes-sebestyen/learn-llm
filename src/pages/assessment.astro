---
import diagnostic from '../../assessment/diagnostic.json';
import '../styles/assessment.scss';

const scenarios = diagnostic.scenarios.map(
  ({ id, title, prompt, initialTranscript, modules }) => ({
    id,
    title,
    prompt,
    initialTranscript,
    modules,
  })
);
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Interaktív LLM-használati diagnosztika prototípus."
    />
    <title>Diagnosztika – learn-llm</title>
  </head>

  <body>
    <main class="page-shell">
      <header class="topbar">
        <div class="brand">
          <a href="/">learn-llm</a>
          <span>diagnosztikai prototípus</span>
        </div>
      </header>

      <section class="intro">
        <h1>Beszélgetés-alapú diagnosztika</h1>
        <p>
          Válassz egy helyzetet, majd válaszolj úgy, mintha ténylegesen egy
          LLM-mel dolgoznál. A beszélgetés végén az evaluator a megfigyelt
          viselkedés alapján értékeli a releváns készségeket.
        </p>
      </section>

      <section class="workspace">
        <aside class="panel scenario-panel">
          <h2>Feladat</h2>
          <p>A statikus diagnosztikai készletből választott scenario.</p>

          <label>
            <span class="message-label">Scenario</span>
            <select id="scenario-select">
              {
                scenarios.map((scenario, index) => (
                  <option value={scenario.id} selected={index === 0}>
                    {scenario.title}
                  </option>
                ))
              }
            </select>
          </label>

          <div class="scenario-card">
            <div class="scenario-title" id="scenario-title"></div>
            <div class="scenario-prompt" id="scenario-prompt"></div>
            <div class="module-tags" id="module-tags"></div>
          </div>

          <div class="helper">
            A modul-hozzárendelés most fejlesztői segítségként látszik. Egy
            valódi diagnosztikában ezt érdemes lehet elrejteni a felmérés
            végéig.
          </div>
        </aside>

        <section class="panel conversation-panel">
          <header class="conversation-header">
            <div>
              <h2>Beszélgetés</h2>
              <p id="turn-counter">0 forduló</p>
            </div>

            <div class="conversation-actions">
              <button class="button" type="button" id="reset-button">
                Újrakezdés
              </button>
              <button
                class="button"
                type="button"
                id="evaluate-button"
                disabled
              >
                Kiértékelés
              </button>
            </div>
          </header>

          <div class="messages" id="messages" aria-live="polite">
            <div class="empty-state" id="empty-state">
              Írd meg az első lépésedet vagy kérdésedet.
            </div>
          </div>

          <form class="composer" id="composer">
            <textarea
              id="message-input"
              placeholder="Mit írnál az LLM-nek?"
              required
            ></textarea>
            <button class="button primary" type="submit">Küldés</button>
          </form>
        </section>
      </section>
    </main>

    <dialog id="evaluation-dialog">
      <div class="dialog-content">
        <h2>Kiértékelés</h2>
        <div id="evaluation-summary" aria-live="polite"></div>

        <div class="dialog-actions">
          <button class="button primary" type="button" id="close-dialog">
            Rendben
          </button>
        </div>
      </div>
    </dialog>

    <script
      type="application/json"
      id="scenario-data"
      set:html={JSON.stringify(scenarios)}
    ></script>
    <script src="../scripts/assessment.ts"></script>
  </body>
</html>
